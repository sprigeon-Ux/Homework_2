/* WEBSITE COLOR PALETTE */

:root {
    --navy: #172554;
    --blue: #93C5FD;
    --light-blue: #DBEAFE;
    --white: #FFFFFF;
    --light-gray: #EFF6FF;
    --dark-text: #1E293B;
}

/* GENERAL STYLING */

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background-color: var(--light-blue);
    color: var(--dark-text);
    font-family: "Open Sans", sans-serif;
    line-height: 1.6;
}

h1, h2, h3 {
    font-family: "Poppins", sans-serif;
    color: var(--navy);
}

/* HEADER */

header {
    background-color: var(--navy);
    color: var(--white);
    text-align: center;
    padding: 32px 16px;
}

header h1 {
    color: var(--white);
}

/* NAVIGATION */

nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 24px;
}

nav a {
    color: var(--white);
    text-decoration: none;
    font-weight: 700;
}

nav a:hover,
nav a[aria-current="page"] {
    color: var(--blue);
}

/* MAIN CONTENT */

main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px;
}

section {
    background-color: var(--white);
    padding: 24px;
    margin-bottom: 24px;
    border-radius: 12px;
}

/* HOME IMAGE */

#home img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin-top: 16px;
}

/* LINKS */

a {
    color: #1D4ED8;
}

/* FOOD CARDS */

.foods {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.food-card {
    background-color: var(--light-blue);
    padding: 24px;
    border: 2px solid var(--blue);
    border-radius: 12px;
}

/* CONTACT FORM */

form {
    margin-top: 24px;
}

fieldset {
    border: 2px solid var(--blue);
    border-radius: 12px;
    padding: 24px;
}

legend {
    color: var(--navy);
    font-weight: 700;
}

.form-group {
    margin-bottom: 24px;
}

label {
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
}

input,
textarea {
    width: 100%;
    padding: 16px;
    border: 1px solid var(--blue);
    border-radius: 8px;
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
}

.error-message {
    color: #991B1B;
    font-size: 14px;
}

button {
    background-color: var(--navy);
    color: var(--white);
    padding: 16px 24px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background-color: #1E40AF;
}

/* FOOTER */

footer {
    background-color: var(--navy);
    color: var(--white);
    text-align: center;
    padding: 24px;
}

footer p {
    margin: 0;
}

/* TABLET */

@media screen and (max-width: 768px) {

    main {
        padding: 16px;
    }

    .foods {
        grid-template-columns: repeat(2, 1fr);
    }

    nav {
        gap: 16px;
    }

}

/* MOBILE */

@media screen and (max-width: 480px) {

    main {
        padding: 8px;
    }

    section {
        padding: 16px;
    }

    .foods {
        grid-template-columns: 1fr;
    }

    nav {
        flex-direction: column;
        gap: 16px;
    }

    header {
        padding: 24px 16px;
    }

    h1 {
        font-size: 24px;
    }

    h2 {
        font-size: 20px;
    }

}
